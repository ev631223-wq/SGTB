@model dynamic
@{
    ViewBag.Title = "Gestión de Conductores";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var cond = Model;
    int idVal = 0;
    string cedulaVal = "";
    string nombreVal = "";
    string licenciaVal = "";
    string telefonoVal = "";
    string estadoVal = "";

    if (cond != null)
    {
        try { idVal = cond.Id; } catch { }
        try { cedulaVal = cond.Cedula ?? ""; } catch { }
        try { nombreVal = cond.Nombre ?? ""; } catch { }
        try { licenciaVal = cond.Licencia ?? ""; } catch { }
        try { telefonoVal = cond.Telefono ?? ""; } catch { }
        try { estadoVal = cond.Estado ?? ""; } catch { }
    }
}

<div class="container mt-4">
    <h2>Gestión de Conductores</h2>
    <hr />

   
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white" style="background-color: darkblue !important;">
            @(idVal > 0 ? "Editar Conductor" : "Registrar Nuevo Conductor")
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Guardar", "Conductores", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@idVal" />

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label>Nombre:</label>
                        <input type="text" name="Nombre" class="form-control" required value="@nombreVal" placeholder="Ej: Juan Pérez" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Teléfono:</label>
                        <input type="text" name="Telefono" class="form-control" required value="@telefonoVal" placeholder="Ej: 555-1234" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Estado:</label>
                        <select name="Estado" class="form-control" required>
                            <option value="">Seleccione estado</option>
                            <option value="Activo" @(estadoVal == "Activo" ? "selected" : "")>Activo</option>
                            <option value="Inactivo" @(estadoVal == "Inactivo" ? "selected" : "")>Inactivo</option>
                            <option value="Vacaciones" @(estadoVal == "Vacaciones" ? "selected" : "")>Vacaciones</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label>Cédula:</label>
                        <input type="text" name="Cedula" class="form-control" required value="@cedulaVal" placeholder="Ej: 1234567890" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Licencia:</label>
                        <input type="text" name="Licencia" class="form-control" required value="@licenciaVal" placeholder="Ej: C1" />
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success me-5">Guardar</button>
                    <a href="@Url.Action("Index", "Conductores")" class="btn btn-secondary">Cancelar</a>
                </div>
            }
        </div>
    </div>

    
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Cédula</th>
                        <th>Nombre</th>
                        <th>Licencia</th>
                        <th>Teléfono</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.ListaConductores != null)
                    {
                        foreach (var item in ViewBag.ListaConductores)
                        {
                            <tr>
                                <td>@item.Cedula</td>
                                <td>@item.Nombre</td>
                                <td>@item.Licencia</td>
                                <td>@item.Telefono</td>
                                <td>
                                    <span class="badge @(item.Estado == "Activo" ? "bg-success" : (item.Estado == "Inactivo" ? "bg-danger" : "bg-warning text-dark"))">
                                        @item.Estado
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("Index", "Conductores", new { id = item.Id })" class="btn btn-sm btn-primary me-5" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a href="@Url.Action("Eliminar", "Conductores", new { id = item.Id })" class="btn btn-sm btn-danger" title="Eliminar" onclick="return confirm('¿Estás seguro de eliminar este conductor?');">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>