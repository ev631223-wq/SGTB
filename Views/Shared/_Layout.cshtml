@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - SGTB</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        
        body {
            overflow-x: hidden;
        }

        #sidebar {
            min-width: 260px;
            max-width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
            transition: all 0.3s;
        }
             
            #sidebar.active {
                margin-left: -260px;
            }

        #content {
            width: 100%;
            margin-left: 260px;
            transition: all 0.3s;
        }
            
            #content.active {
                margin-left: 0;
            }

        #sidebar .nav-link {
            transition: all 0.2s ease-in-out;
        }

        #sidebar .nav-link {
            transition: all 0.2s ease-in-out;
        }

            #sidebar .nav-link:hover {
                background-color: #ffffff !important;
                color: #000000 !important;
                border-radius: 6px;
                transform: translateX(5px); 
            }


        @@media (max-width: 991.98px) {
            #sidebar {
                margin-left: -260px;
            }

                #sidebar.active {
                    margin-left: 0;
                }

            #content {
                margin-left: 0 !important;
                width: 100% !important;
            }
        }
    </style>
</head>
<body class="bg-light">

    <div class="d-flex">
       
        <nav id="sidebar" class="text-white p-3 d-flex flex-column justify-content-between shadow" style="background-color: #0B192C;">
            <div>

                <div class="d-flex justify-content-between align-items-center mb-4 px-2">
                    <a class="navbar-brand text-white fw-bold fs-4 text-decoration-none" href="#">SGTB</a>

                    <button class="btn btn-dark d-lg-none" type="button" id="sidebarCollapseMobile">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>


                <div>
                    <ul class="nav flex-column gap-2">
                        <li class="nav-item">
                            <a class="nav-link text-white rounded py-2 px-3" href="@Url.Action("Index", "Buses")">
                                <i class="bi bi-bus-front me-2"></i> Buses
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white rounded py-2 px-3" href="@Url.Action("Index", "Conductores")">
                                <i class="bi bi-person-badge me-2"></i> Conductores
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white rounded py-2 px-3" href="@Url.Action("Index", "Viajes")">
                                <i class="bi bi-geo-alt me-2"></i> Viajes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white rounded py-2 px-3" href="@Url.Action("Consultas", "Viajes")">
                                <i class="bi bi-question-circle me-2"></i> Consultas de Viajes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white rounded py-2 px-3" href="@Url.Action("Index", "Rutas")">
                                <i class="bi bi-map me-2"></i> Rutas
                            </a>
                        </li>
                    </ul>
                </div>
            </div>


            <div class="mt-auto pt-3 border-top border-secondary">
                <a href="@Url.Action("Login", "Acceso")" class="btn btn-outline-light w-100 btn-sm">
                    <i class="bi bi-x-lg me-1"></i> Cerrar Sesión
                </a>
            </div>
        </nav>

        
        <div id="content" class="p-4">
            
            <nav class="navbar navbar-expand navbar-light bg-white shadow-sm mb-4 px-3 rounded">
                <div class="container-fluid">
                    <button type="button" id="sidebarCollapse" class="btn btn-dark btn-sm">
                        <i class="bi bi-list"></i> Menú
                    </button>
                </div>
            </nav>

            <div id="alerta-bienvenida-container" class="container-fluid"></div>

            <script>
                if (localStorage.getItem("mostrarBienvenida") === "true") {
                    localStorage.removeItem("mostrarBienvenida");

                    const container = document.getElementById("alerta-bienvenida-container");
                    container.innerHTML = `
                                    <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin-top: 10px;">
                                        <strong>¡Bienvenido!</strong> Inicio de sesión exitoso al sistema SGTB.
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                    </div>
                                `;
                }
            </script>

            @RenderBody()
        </div>
    </div>

    
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('sidebarCollapse').addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('active');
            document.getElementById('content').classList.toggle('active');
        });
    </script>
</body>
</html>